<?xml version="1.0"?>
<!-- Reduced to the 13 controlled joints (6 per leg + waist_yaw). Everything
     that was a `type="fixed"` joint in the original 29-DOF description
     (pelvis_contour, waist_roll/pitch, logo, head, IMU/camera/lidar mounts,
     both arms) has been removed: its mesh geometry was reparented onto the
     nearest surviving ancestor link (pelvis or waist_yaw_link) with the
     link's static offset baked into each <visual>/<collision> origin, and
     its mass/inertia was fused into that ancestor's <inertial> via the
     standard parallel-axis-theorem rigid-body composition (computed with
     Pinocchio, not by hand -- see the fused mass/inertia values below).
     Total robot mass is unchanged (33.001142 kg, same as before). -->
<robot name="g1_13dof">
  <material name="dark">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>
  <material name="white">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>

  <mujoco>
    <compiler meshdir="meshes" discardvisual="false"/>
  </mujoco>

  <!-- pelvis: fused with pelvis_contour_link (mass 0.001 kg, negligible but
       included for exactness) -->
  <link name="pelvis">
    <inertial>
      <origin xyz="0 0 -0.0760300603" rpy="0 0 0"/>
      <mass value="3.814"/>
      <inertia ixx="0.01055488209" ixy="0" ixz="2.1e-06" iyy="0.009314782086" iyz="0" izz="0.0079185"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/pelvis.STL"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/pelvis_contour_link.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/pelvis_contour_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- Legs (unchanged: no fixed joints in either leg chain) -->
  <link name="left_hip_pitch_link">
    <inertial>
      <origin xyz="0.002741 0.047791 -0.02606" rpy="0 0 0"/>
      <mass value="1.35"/>
      <inertia ixx="0.001811" ixy="3.68E-05" ixz="-3.44E-05" iyy="0.0014193" iyz="0.000171" izz="0.0012812"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/left_hip_pitch_link.STL"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/left_hip_pitch_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_hip_pitch_joint" type="revolute">
    <origin xyz="0 0.064452 -0.1027" rpy="0 0 0"/>
    <parent link="pelvis"/>
    <child link="left_hip_pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5307" upper="2.8798" effort="88" velocity="32"/>
  </joint>
  <link name="left_hip_roll_link">
    <inertial>
      <origin xyz="0.029812 -0.001045 -0.087934" rpy="0 0 0"/>
