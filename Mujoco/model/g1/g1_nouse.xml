<mujoco model="g1_13dof">
  <!-- Reduced to the 13 controlled joints (6 per leg + waist_yaw). Bodies
       that had no <joint> in the previous version (pelvis_contour_link,
       waist_roll/torso/logo/head, both full arm chains) have been removed;
       their geoms are now direct children of the nearest surviving body
       (pelvis or waist_yaw_link) with the removed body's static offset
       baked into each geom's pos/quat, and their mass/inertia was fused
       into that surviving body's <inertial> via Pinocchio's rigid-body
       composition (parallel-axis theorem), not by hand. Total robot mass
       is unchanged (33.001142 kg). See Controller/model/g1/g1.urdf for the
       matching URDF-side reduction and the same fused inertia numbers. -->
  <compiler angle="radian" meshdir="assets"/>

  <option integrator="implicitfast" timestep="0.001"/>

  <default>
    <default class="g1">
      <site rgba="1 0 0 1" size="0.01" group="5"/>
      <joint armature="0.01" frictionloss="0.3"/>
      <!-- Upstream menagerie uses dampratio/inheritrange (MuJoCo >=3.1.6),
           but this project vendors 3.1.2 (pinned for GCC 9.4 compatibility,
           see Mujoco/CMakeLists.txt), which rejects both attributes. kv=50
           is an untuned stand-in for the dampratio=1 critical damping this
           model was designed around; ctrlrange is left unlimited since
           inheritrange isn't available to copy each joint's range over. -->
      <position kp="500" kv="50"/>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0" density="0" material="metal"/>
      </default>
      <default class="collision">
        <geom group="3" type="mesh"/>
        <default class="foot">
          <geom type="sphere" size="0.005" priority="1" friction="0.6" condim="3"/>
        </default>
      </default>
    </default>
  </default>

